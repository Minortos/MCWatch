    "%@ - MC Watch has to be run from the Applications folder to work properly." : {
      "comment" : "%@ est la raison du refus, elle-même déjà traduite",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - MC Watch muss aus dem Ordner „Programme“ gestartet werden, damit es richtig funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - MC Watch debe ejecutarse desde la carpeta Aplicaciones para funcionar correctamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ - MC Watch doit être lancé depuis le dossier Applications pour fonctionner correctement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - MC Watch deve essere avviato dalla cartella Applicazioni per funzionare correttamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - MC Watch moet vanuit de map Programma's worden gestart om goed te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - MC Watch musi być uruchamiany z folderu Aplikacje, aby działał poprawnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - O MC Watch precisa ser executado a partir da pasta Aplicativos para funcionar corretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - MC Watch должен запускаться из папки «Программы», иначе он не работает как надо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ - MC Watch'ın düzgün çalışması için Uygulamalar klasöründen çalıştırılması gerekir."
          }
        }
      }
    },
    "%@ is a watched server — it is not marked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist ein überwachter Server — er wird nicht markiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ es un servidor vigilado: no se marca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un serveur surveillé — il ne se marque pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ è un server sorvegliato — non viene contrassegnato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ is een gevolgde server — die wordt niet gemarkeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ to obserwowany serwer — nie oznacza się go."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ é um servidor monitorado — ele não recebe marcação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",

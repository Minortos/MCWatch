    "The key is kept in your macOS login keychain, it is not visible to the other accounts on this Mac - An invalid key is never saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Schlüssel liegt im Anmeldeschlüsselbund von macOS, er ist für die anderen Benutzerkonten dieses Macs nicht sichtbar - Ein ungültiger Schlüssel wird nie gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clave se guarda en el llavero de inicio de sesión de macOS, no es visible para las demás cuentas de este Mac - Una clave no válida nunca se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clef est gardée dans le trousseau de session macOS, elle n'est pas visible par les autres sessions de ce Mac - Une clef invalide n'est jamais enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La chiave resta nel portachiavi di accesso di macOS, non è visibile agli altri account di questo Mac - Una chiave non valida non viene mai salvata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De sleutel blijft in je macOS-inlogsleutelhanger, hij is niet zichtbaar voor de andere accounts op deze Mac - Een ongeldige sleutel wordt nooit bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klucz jest przechowywany w pęku kluczy logowania macOS, nie jest widoczny dla innych kont na tym Macu - Nieprawidłowy klucz nigdy nie zostaje zapisany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A chave fica no chaveiro de início de sessão do macOS, ela não é visível para as outras contas deste Mac - Uma chave inválida nunca é salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ключ хранится в связке ключей входа macOS и не виден другим учётным записям этого Mac - Неверный ключ не сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anahtar macOS oturum açma anahtar zincirinde tutulur, bu Mac'teki diğer hesaplara görünmez - Geçersiz bir anahtar asla kaydedilmez."
          }
        }
      }
    },
